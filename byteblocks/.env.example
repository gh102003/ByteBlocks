VITE_OPENAI_API_KEY=your-openai-api-key
VITE_AI_PROVIDER=openai
VITE_AI_MODEL=gpt-4.1-mini
# Optional Responses API endpoint override:
# VITE_AI_BASE_URL=https://api.openai.com/v1

# Realtime voice: server-only values, loaded by the Vite dev endpoint.
# Run ElevenLabs onboarding to populate .env.local, then provision the agent:
# node --env-file=.env.local scripts/setup-voice-agent.mjs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-private-realtime-agent-id
