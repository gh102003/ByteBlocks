VITE_OPENAI_API_KEY=your-openai-api-key
# Production: set both values to use the authenticated Worker instead of a browser API key.
# VITE_WORKER_URL=https://byteblocks-api.YOUR_SUBDOMAIN.workers.dev
# VITE_AUTH0_AUDIENCE=https://byteblocks-api
VITE_AI_PROVIDER=openai
VITE_AI_MODEL=gpt-4.1-mini
# Optional Responses API endpoint override:
# VITE_AI_BASE_URL=https://api.openai.com/v1

# Auth0: public SPA application values. Configure the same callback, logout,
# and web-origin URLs in the Auth0 dashboard for each deployment.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# Auth0 profile storage: server-only Machine-to-Machine application values.
# Grant this application read:users and update:users in the Auth0 Management API.
# Do not prefix these values with VITE_.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret

# Realtime voice: server-only values, loaded by the Vite dev endpoint.
# Run ElevenLabs onboarding to populate .env.local, then provision the agent:
# node --env-file=.env.local scripts/setup-voice-agent.mjs
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-private-realtime-agent-id
