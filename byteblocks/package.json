{
  "name": "byteblocks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -b",
    "format": "prettier --write . ../.github/workflows",
    "format:check": "prettier --check . ../.github/workflows",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.110",
    "@ai-sdk/react": "^4.0.168",
    "@auth0/auth0-react": "^2.30.0",
    "ai": "^7.0.164",
    "monaco-editor": "0.57.0",
    "pyodide": "314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.1.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
